{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"${npm_config_user_agent:-$npm_execpath}\" in *pnpm*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build:supabase-email-templates": "node scripts/build-supabase-auth-email-templates.mjs",
    "apply:supabase-email-templates": "node scripts/apply-supabase-email-templates.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "test:physical-room-inventory": "pnpm --filter @workspace/api-server exec tsx --test ../catstays/src/app/lib/roomInventory.test.ts ../catstays/src/app/lib/staffRoomTimeline.test.ts src/lib/physicalRoomInventory.test.ts",
    "test:staff-booking-operations": "pnpm --filter @workspace/api-server exec tsx --test ../catstays/src/app/lib/bookingSetup.test.ts ../catstays/src/app/lib/bookingOperations.test.ts ../catstays/src/app/lib/bookingPricing.test.ts ../catstays/src/app/lib/bookingSchedule.test.ts ../catstays/src/app/lib/roomInventory.test.ts ../catstays/src/app/lib/staffRoomTimeline.test.ts",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
